# ocd settings for this project (sourced by bash). Commit it.
# Name of this project's rules skill in .opencode/skills/.
OCD_PROJECT_SKILL=project-rules
# Prepended to PATH for every command (e.g. a local Node install), or empty.
OCD_PATH_PREFIX=
# Checks the gate runs, separated by |. Each runs with pipefail.
OCD_CHECKS="{{checks}}"
# Changed files matching this regex are listed as "read these in full".
OCD_RISKY_PATHS='migrations/|\.sql$|/auth/|security|/api/|\.env|config\.'
# Added lines matching this regex (code only) are shown as red flags.
OCD_REDFLAGS='security definer|grant |service_role|dangerouslySetInnerHTML|eval\(|console\.log|TODO|: any\b|as any\b'
# Optional executable for project-only gate checks; gets the base ref as $1.
OCD_EXTRA_CHECKS=
# Models (see the shared scorecard for which is good at what).
OCD_PLANNER=step-5-preview-free
OCD_BUILDER=mimo-v2.6-flash-free
OCD_REVIEWER=step-5-preview-free
OCD_FALLBACK=nemotron-3-ultra-free
